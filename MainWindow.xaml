<Window x:Class="DartLeague.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dartboard" Height="860" Width="1400" MinHeight="700" MinWidth="1040" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="18,24">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <Image Source="{StaticResource DartboardIcon}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Dartboard" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Tournament workspace" Foreground="#8D9AAF" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#728097" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,9"/>
                    <Button x:Name="NavOverview" Style="{StaticResource SidebarButton}" Background="#202B3F" Foreground="White" Click="ShowDashboard_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌂" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Overview" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Border Height="1" Background="#263247" Margin="12,19,12,17"/>
                    <TextBlock Text="COMPETITION" Foreground="#728097" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,9"/>
                    <Button x:Name="NavMatches" Style="{StaticResource SidebarButton}" Click="ShowMatches_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="≡" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Matches" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button x:Name="NavStandings" Style="{StaticResource SidebarButton}" Click="ShowStandings_Click" Margin="0,3,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="#" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Standings" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button x:Name="NavStatistics" Style="{StaticResource SidebarButton}" Click="ShowStats_Click" Margin="0,3,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="∿" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Statistics" VerticalAlignment="Center"/></Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,32">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CompetitionSelector" Width="292" DisplayMemberPath="DisplayName" SelectionChanged="CompetitionSelector_SelectionChanged"/>
                    <Button Content="New competition" Click="NewCompetition_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" MinHeight="0" ClipToBounds="True">
                    <Grid x:Name="DashboardView" Style="{StaticResource ViewportView}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border CornerRadius="18" Padding="30" BorderBrush="#5E63F0" BorderThickness="1">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5658D9" Offset="0"/><GradientStop Color="#7262DD" Offset="0.55"/><GradientStop Color="#8E61DC" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ACTIVE COMPETITION" Foreground="#DCDDFF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="DashboardCompetitionText" Text="No competition selected" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock x:Name="DashboardFormatText" Foreground="#EAEBFF" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Enter results" Click="OpenMatches_Click" Background="White" Foreground="#4E50CC" Margin="0,0,10,0"/><Button Content="Table" Click="OpenStandings_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,20,0,20">
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Players" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="PlayerCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="6,0"><StackPanel><TextBlock Text="Matches" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="MatchCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="12,0,0,0"><StackPanel><TextBlock Text="Completed" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="PlayedCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="20"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="Next matches" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select to record" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid><DataGrid x:Name="NextMatchesGrid" SelectionChanged="NextMatchesGrid_SelectionChanged"><DataGrid.Columns>
                                <DataGridTextColumn Header="ROUND" Binding="{Binding RoundNumber, StringFormat=Round {0}}" Width="95"/>
                                <DataGridTextColumn Header="HOME" Binding="{Binding HomePlayer}" Width="*"/>
                                <DataGridTextColumn Header="AWAY" Binding="{Binding AwayPlayer}" Width="*"/>
                            </DataGrid.Columns></DataGrid></DockPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="20,0,0,0"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="Table leaders" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Top 5" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid><DataGrid x:Name="TopStandingsGrid"><DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="48"/>
                                <DataGridTextColumn Header="PLAYER" Binding="{Binding Player}" Width="*"/>
                                <DataGridTextColumn Header="P" Binding="{Binding Played}" Width="52"/>
                                <DataGridTemplateColumn Header="PTS" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource PointsPill}" Padding="8,4"><TextBlock Text="{Binding Points}" Foreground="#5456CC" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns></DataGrid></DockPanel></Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SetupView" Style="{StaticResource ViewportView}" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="26"><StackPanel><TextBlock Text="Competition details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Name" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><TextBox x:Name="SeasonNameTextBox" Text="New dart season"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Type" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><ComboBox x:Name="CompetitionTypeComboBox" SelectedIndex="0"><ComboBoxItem Content="Season" Tag="Season"/><ComboBoxItem Content="Tournament" Tag="Tournament"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="Meetings" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><ComboBox x:Name="MeetingsComboBox" SelectedIndex="0"><ComboBoxItem Content="Once" Tag="1"/><ComboBoxItem Content="Twice" Tag="2"/><ComboBoxItem Content="Three times" Tag="3"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Format" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><ComboBox x:Name="LegsToWinComboBox" SelectedIndex="1"><ComboBoxItem Content="First to 2 legs" Tag="2"/><ComboBoxItem Content="First to 3 legs" Tag="3"/><ComboBoxItem Content="First to 4 legs" Tag="4"/><ComboBoxItem Content="First to 5 legs" Tag="5"/></ComboBox></StackPanel>
                        </Grid></StackPanel></Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="26" Margin="0,20,0,0"><DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="Players" FontSize="18" FontWeight="SemiBold"/><Button Content="Add player" Click="AddPlayer_Click" HorizontalAlignment="Right"/></Grid>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemovePlayer_Click"/><Button Content="Create competition" Click="StartSeason_Click" Margin="10,0,0,0"/></StackPanel>
                            <DataGrid x:Name="PlayersGrid" ItemsSource="{Binding Players}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" IsReadOnly="True" Width="64"/><DataGridTextColumn Header="PLAYER NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
                        </DockPanel></Border>
                    </Grid>

                    <Grid x:Name="MatchesView" Style="{StaticResource ViewportView}" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Match list" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="MatchFilterComboBox" Width="160" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="MatchFilterComboBox_SelectionChanged"><ComboBoxItem Content="All matches" Tag="All"/><ComboBoxItem Content="Open matches" Tag="Open"/><ComboBoxItem Content="Completed" Tag="Completed"/></ComboBox></Grid><DataGrid x:Name="MatchesGrid" SelectionChanged="MatchesGrid_SelectionChanged"><DataGrid.Columns>
                            <DataGridTextColumn Header="ROUND" Binding="{Binding RoundNumber, StringFormat=Round {0}}" Width="100"/>
                            <DataGridTextColumn Header="HOME" Binding="{Binding HomePlayer}" Width="*"/>
                            <DataGridTemplateColumn Header="RESULT" Width="118"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ScorePill}"><TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="AWAY" Binding="{Binding AwayPlayer}" Width="*"/>
                            <DataGridTemplateColumn Header="STATUS" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusPill}"><TextBlock Text="{Binding Status}" Foreground="#4A5568" FontSize="11" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns></DataGrid></DockPanel></Border>
                        <Border Grid.Row="1" Background="#111827" CornerRadius="16" Padding="22" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="22"/><ColumnDefinition Width="128"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="1. RECORD RESULT" Foreground="#8F9CB2" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SelectedMatchText" Text="Select a match" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><Button Content="−" Tag="Home:-1" Click="AdjustScore_Click" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="16"/><TextBox x:Name="HomeScoreTextBox" Grid.Column="1" Style="{StaticResource ScoreBox}" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="+" Tag="Home:1" Click="AdjustScore_Click" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="16"/></Grid>
                            <TextBlock Grid.Column="2" Text="–" Foreground="#8F9CB2" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><Button Content="−" Tag="Away:-1" Click="AdjustScore_Click" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="16"/><TextBox x:Name="AwayScoreTextBox" Grid.Column="1" Style="{StaticResource ScoreBox}" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="+" Tag="Away:1" Click="AdjustScore_Click" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="16"/></Grid>
                            <Button Grid.Column="4" Content="Clear" Click="ClearResult_Click" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="5" Content="Save result" Click="SaveResult_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="2. MATCH STATISTICS" Foreground="#5456CC" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="StatsMatchText" Text="Select a played match" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="StatsPlayerText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,10"/><ComboBox x:Name="StatsPlayerComboBox" SelectionChanged="StatsPlayerComboBox_SelectionChanged"><ComboBoxItem Content="Home player" Tag="Home"/><ComboBoxItem Content="Away player" Tag="Away"/></ComboBox></StackPanel>
                            <UniformGrid Grid.Column="1" Columns="4" Margin="16,0,16,0"><StackPanel Margin="0,0,8,12"><TextBlock Text="3-dart AVG" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="AverageTextBox"/></StackPanel><StackPanel Margin="8,0,8,12"><TextBlock Text="Legs" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="LegsTextBox"/></StackPanel><StackPanel Margin="8,0,8,12"><TextBlock Text="High finish" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="HighFinishTextBox"/></StackPanel><StackPanel Margin="8,0,0,12"><TextBlock Text="Short leg" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="ShortLegTextBox"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="80+" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="Scores80TextBox"/></StackPanel><StackPanel Margin="8,0,8,0"><TextBlock Text="100+" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="Scores100TextBox"/></StackPanel><StackPanel Margin="8,0,8,0"><TextBlock Text="140+" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="Scores140TextBox"/></StackPanel></UniformGrid>
                            <Button Grid.Column="2" Content="Save statistics" Click="SaveStats_Click" VerticalAlignment="Bottom"/>
                        </Grid></Border>
                    </Grid>

                    <Grid x:Name="StandingsView" Style="{StaticResource ViewportView}" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="20"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="League table" FontSize="18" FontWeight="SemiBold"/><Button Content="Export CSV" Click="ExportStandings_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"/></Grid><DataGrid x:Name="StandingsGrid"><DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="29" Height="29" CornerRadius="14.5" Background="#F0F2F6"><TextBlock Text="{Binding Position}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4A5568"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="PLAYER" Binding="{Binding Player}" Width="*"/>
                        <DataGridTextColumn Header="P" Binding="{Binding Played}" Width="58"/><DataGridTextColumn Header="W" Binding="{Binding Won}" Width="58"/><DataGridTextColumn Header="L" Binding="{Binding Lost}" Width="58"/><DataGridTextColumn Header="LEGS +" Binding="{Binding LegsFor}" Width="78"/><DataGridTextColumn Header="LEGS −" Binding="{Binding LegsAgainst}" Width="78"/><DataGridTextColumn Header="DIFF." Binding="{Binding LegDifference, StringFormat={}{0:+#;-#;0}}" Width="76"/>
                        <DataGridTemplateColumn Header="POINTS" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource PointsPill}"><TextBlock Text="{Binding Points}" Foreground="#4D4FC7" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns></DataGrid></DockPanel></Border></Grid>

                    <Grid x:Name="StatsView" Style="{StaticResource ViewportView}" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="20"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Player statistics" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Season totals" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid><DataGrid x:Name="StatisticsGrid"><DataGrid.Columns>
                            <DataGridTextColumn Header="PLAYER" Binding="{Binding Player}" Width="*"/>
                            <DataGridTextColumn Header="3-DART AVG" Binding="{Binding Average, StringFormat={}{0:F2}}" Width="98"/><DataGridTextColumn Header="GAMES" Binding="{Binding Games}" Width="70"/><DataGridTextColumn Header="LEGS" Binding="{Binding Legs}" Width="70"/><DataGridTextColumn Header="HF" Binding="{Binding HighFinish}" Width="62"/><DataGridTextColumn Header="SL" Binding="{Binding ShortLeg}" Width="62"/><DataGridTextColumn Header="80+" Binding="{Binding Scores80}" Width="62"/><DataGridTextColumn Header="100+" Binding="{Binding Scores100}" Width="68"/><DataGridTextColumn Header="140+" Binding="{Binding Scores140}" Width="68"/>
                        </DataGrid.Columns></DataGrid></DockPanel></Border></Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
